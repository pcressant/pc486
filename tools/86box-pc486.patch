+#include <cstdio>
 #include "wl_mouse.hpp"
 #include <QGuiApplication>
 #include <wayland-client-core.h>
@@ -103,11 +104,42 @@
 void
 wl_keyboard_grab(QWindow *window)
 {
+    /* pc486 : s'enregistrer auprès du compositeur avant la demande ; sinon, appelée juste
+       après l'ouverture de la fenêtre, elle part avant wl_init() et ne fait rien. */
+    wl_init();
     if (!kbd_inhibitor && kbd_manager) {
+        fprintf(stderr, "pc486-grab on\n");
         kbd_inhibitor = zwp_keyboard_shortcuts_inhibit_manager_v1_inhibit_shortcuts(kbd_manager, (wl_surface *) QGuiApplication::platformNativeInterface()->nativeResourceForWindow("surface", window), (wl_seat *) QGuiApplication::platformNativeInterface()->nativeResourceForIntegration("wl_seat"));
     }
 }
 
+/* pc486 : Ctrl+Alt+G bascule le blocage des raccourcis du compositeur, comme sous QEMU. */
+static bool kbd_released = false;   /* relâché par Ctrl+Alt+G : ne pas reprendre seul */
+
+void
+wl_keyboard_toggle_grab(QWindow *window)
+{
+    if (kbd_inhibitor) {
+        zwp_keyboard_shortcuts_inhibitor_v1_destroy(kbd_inhibitor);
+        kbd_inhibitor = nullptr;
+        kbd_released  = true;
+        fprintf(stderr, "pc486-grab off\n");
+    } else {
+        kbd_released = false;
+        wl_keyboard_grab(window);
+    }
+}
+
+/* pc486 : au démarrage, la liaison au gestionnaire de raccourcis peut arriver après la
+   demande (événements Wayland traités par le fil de Qt) : redemander à chaque fois que
+   la fenêtre reprend le focus. */
+void
+wl_keyboard_autograb(QWindow *window)
+{
+    if (!kbd_released)
+        wl_keyboard_grab(window);
+}
